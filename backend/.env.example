# Smart Park Configuration
DAILY_CAPACITY=1000
MAX_TICKETS_PER_TRANSACTION=200
BOOKING_WINDOW_DAYS=30

# Ticket Pricing (EGP)
TICKET_PRICE_CHILD_DAILY=100
TICKET_PRICE_ADULT_DAILY=200
TICKET_PRICE_SENIOR_DAILY=150
TICKET_PRICE_CHILD_MONTHLY=1500
TICKET_PRICE_ADULT_MONTHLY=3000
TICKET_PRICE_SENIOR_MONTHLY=2000

# Email Configuration (Gmail)
EMAIL_USER=xxxxxxxxxxxxxxxxxxxx
EMAIL_PASS=xxxxxxxxxxxxxxxxxxxx

